// index.js - Servidor Orquestador Inmutable
const express = require('express');
const { GoogleAuth } = require('google-auth-library');

const app = express();
app.use(express.json()); // Permite procesar payloads estructurados (JSON)

const PORT = process.env.PORT || 10000;
const MODEL_VERSION = process.env.GEMINI_MODEL_VERSION || 'gemini-1.5-pro';

// -------------------------------------------------------------
// REQUISITO CRÍTICO: Endpoint de salud (Health Check) para Render
// -------------------------------------------------------------
app.get('/healthz', (req, res) => {
    // Retorna HTTP 200 OK para confirmar que el contenedor está sano
    res.status(200).json({ status: 'healthy', timestamp: new Date().toISOString() });
});

// -------------------------------------------------------------
// ENDPOINT OPERATIVO: Procesamiento seguro con Gemini
// -------------------------------------------------------------
app.post('/api/procesar', async (req, res) => {
    const { prompt } = req.body;

    if (!prompt) {
        return res.status(400).json({ error: 'Falta el parámetro "prompt" en la solicitud.' });
    }

    try {
        // Inicialización segura de credenciales utilizando la variable de entorno de Google
        const auth = new GoogleAuth({
            scopes: 'https://www.googleapis.com/auth/cloud-platform',
        });
        const client = await auth.getClient();
        const projectId = await auth.getProjectId();

        // En producción, aquí se realiza la llamada al endpoint de Vertex AI / Gemini
        // utilizando el projectId obtenido de forma segura y la versión del modelo fija.
        
        // Simulación de respuesta segura estructurada en auditoría
        res.status(200).json({
            success: true,
            modelUsed: MODEL_VERSION,
            meta: { project: projectId, timestamp: new Date().toISOString() },
            data: `Procesamiento exitoso del prompt: "${prompt}" (Simulado bajo entorno inmutable)`
        });

    } catch (error) {
        console.error('Error de autenticación o ejecución en infraestructura:', error.message);
        res.status(500).json({ error: 'Error interno de configuración de infraestructura.' });
    }
});

// Inicio del servidor en el puerto expuesto por el Dockerfile
app.listen(PORT, () => {
    console.log(`[INFRAESTRUCTURA] Servidor activo e inmutable en el puerto ${PORT}`);
    console.log(`[IA] Versión fijada de Gemini: ${MODEL_VERSION}`);
});

